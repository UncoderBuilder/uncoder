{
  "groups": {
    "entrance": "Entrance",
    "text": "Text",
    "stagger": "Stagger",
    "scroll": "Scroll",
    "interaction": "Hover & click",
    "loop": "Loop"
  },
  "presets": {
    "fade-in": { "label": "Fade in", "group": "entrance", "def": { "trigger": "enter", "from": { "opacity": 0 }, "steps": [{ "to": { "opacity": 1 }, "duration": 800, "ease": "power2.out" }] } },
    "fade-up": { "label": "Fade up", "group": "entrance", "def": { "trigger": "enter", "from": { "opacity": 0, "y": 40 }, "steps": [{ "to": { "opacity": 1, "y": 0 }, "duration": 900, "ease": "power3.out" }] } },
    "fade-down": { "label": "Fade down", "group": "entrance", "def": { "trigger": "enter", "from": { "opacity": 0, "y": -40 }, "steps": [{ "to": { "opacity": 1, "y": 0 }, "duration": 900, "ease": "power3.out" }] } },
    "fade-left": { "label": "Fade from left", "group": "entrance", "def": { "trigger": "enter", "from": { "opacity": 0, "x": -60 }, "steps": [{ "to": { "opacity": 1, "x": 0 }, "duration": 900, "ease": "power3.out" }] } },
    "fade-right": { "label": "Fade from right", "group": "entrance", "def": { "trigger": "enter", "from": { "opacity": 0, "x": 60 }, "steps": [{ "to": { "opacity": 1, "x": 0 }, "duration": 900, "ease": "power3.out" }] } },
    "rise": { "label": "Rise", "group": "entrance", "def": { "trigger": "enter", "from": { "opacity": 0, "y": 90, "rotate": 3 }, "steps": [{ "to": { "opacity": 1, "y": 0, "rotate": 0 }, "duration": 1200, "ease": "power4.out" }] } },
    "pop": { "label": "Pop", "group": "entrance", "def": { "trigger": "enter", "from": { "opacity": 0, "scale": 0.6 }, "steps": [{ "to": { "opacity": 1, "scale": 1 }, "duration": 700, "ease": "back.out" }] } },
    "zoom-settle": { "label": "Zoom settle", "group": "entrance", "def": { "trigger": "enter", "from": { "opacity": 0, "scale": 1.25 }, "steps": [{ "to": { "opacity": 1, "scale": 1 }, "duration": 1200, "ease": "expo.out" }] } },
    "blur-in": { "label": "Blur in", "group": "entrance", "def": { "trigger": "enter", "from": { "opacity": 0, "blur": 16, "scale": 1.05 }, "steps": [{ "to": { "opacity": 1, "blur": 0, "scale": 1 }, "duration": 1000, "ease": "power2.out" }] } },
    "flip-up": { "label": "Flip up", "group": "entrance", "def": { "trigger": "enter", "from": { "opacity": 0, "rotateX": -75, "y": 40 }, "steps": [{ "to": { "opacity": 1, "rotateX": 0, "y": 0 }, "duration": 1100, "ease": "power3.out" }] } },
    "swing-in": { "label": "Swing in", "group": "entrance", "def": { "trigger": "enter", "from": { "opacity": 0, "rotateY": 65 }, "steps": [{ "to": { "opacity": 1, "rotateY": 0 }, "duration": 1100, "ease": "back.out" }] } },
    "skew-slide": { "label": "Skew slide", "group": "entrance", "def": { "trigger": "enter", "from": { "opacity": 0, "x": -80, "skewX": 14 }, "steps": [{ "to": { "opacity": 1, "x": 0, "skewX": 0 }, "duration": 1000, "ease": "expo.out" }] } },
    "elastic-pop": { "label": "Elastic pop", "group": "entrance", "def": { "trigger": "enter", "from": { "opacity": 0, "scale": 0.3 }, "steps": [{ "to": { "opacity": 1 }, "duration": 150, "ease": "none" }, { "to": { "scale": 1 }, "duration": 1300, "ease": "elastic.out" }] } },
    "drop-bounce": { "label": "Drop & bounce", "group": "entrance", "def": { "trigger": "enter", "from": { "opacity": 0, "y": -140 }, "steps": [{ "to": { "opacity": 1 }, "duration": 0, "ease": "none" }, { "to": { "y": 0 }, "duration": 1100, "ease": "bounce.out" }] } },
    "wipe-up": { "label": "Wipe up", "group": "entrance", "def": { "trigger": "enter", "from": { "clip": "wipe-up", "y": 30 }, "steps": [{ "to": { "clip": "none", "y": 0 }, "duration": 1100, "ease": "power4.out" }] } },
    "wipe-right": { "label": "Wipe right", "group": "entrance", "def": { "trigger": "enter", "from": { "clip": "wipe-right" }, "steps": [{ "to": { "clip": "none" }, "duration": 1100, "ease": "power3.inOut" }] } },
    "curtain": { "label": "Curtain open", "group": "entrance", "def": { "trigger": "enter", "from": { "clip": "center-x" }, "steps": [{ "to": { "clip": "none" }, "duration": 1100, "ease": "expo.inOut" }] } },
    "circle-reveal": { "label": "Circle reveal", "group": "entrance", "def": { "trigger": "enter", "from": { "clip": "circle", "scale": 1.1 }, "steps": [{ "to": { "clip": "none", "scale": 1 }, "duration": 1300, "ease": "power2.inOut" }] } },

    "words-rise": { "label": "Words rise", "group": "text", "def": { "trigger": "enter", "target": "words", "from": { "opacity": 0, "y": 24 }, "steps": [{ "to": { "opacity": 1, "y": 0 }, "duration": 700, "ease": "power3.out" }], "stagger": 60 } },
    "words-mask": { "label": "Words from a mask", "group": "text", "def": { "trigger": "enter", "target": "words", "mask": true, "from": { "y": "120%" }, "steps": [{ "to": { "y": "0%" }, "duration": 900, "ease": "expo.out" }], "stagger": 70 } },
    "lines-mask": { "label": "Lines from a mask", "group": "text", "def": { "trigger": "enter", "target": "lines", "mask": true, "from": { "y": "120%" }, "steps": [{ "to": { "y": "0%" }, "duration": 1000, "ease": "power4.out" }], "stagger": 130 } },
    "words-blur": { "label": "Words blur in", "group": "text", "def": { "trigger": "enter", "target": "words", "from": { "opacity": 0, "blur": 12 }, "steps": [{ "to": { "opacity": 1, "blur": 0 }, "duration": 900, "ease": "power2.out" }], "stagger": 90 } },
    "letters-fade": { "label": "Letters fade", "group": "text", "def": { "trigger": "enter", "target": "chars", "from": { "opacity": 0, "y": 14, "blur": 6 }, "steps": [{ "to": { "opacity": 1, "y": 0, "blur": 0 }, "duration": 600, "ease": "power2.out" }], "stagger": 25 } },
    "letters-pop": { "label": "Letters pop", "group": "text", "def": { "trigger": "enter", "target": "chars", "from": { "opacity": 0, "scale": 0, "y": 20 }, "steps": [{ "to": { "opacity": 1, "scale": 1, "y": 0 }, "duration": 600, "ease": "back.out" }], "stagger": 30 } },
    "letters-flip": { "label": "Letters flip", "group": "text", "def": { "trigger": "enter", "target": "chars", "from": { "opacity": 0, "rotateX": -90 }, "steps": [{ "to": { "opacity": 1, "rotateX": 0 }, "duration": 800, "ease": "power3.out" }], "stagger": 35 } },
    "typewriter": { "label": "Typewriter", "group": "text", "def": { "trigger": "enter", "target": "chars", "from": { "opacity": 0 }, "steps": [{ "to": { "opacity": 1 }, "duration": 10, "ease": "none" }], "stagger": 45 } },

    "cascade": { "label": "Cascade up", "group": "stagger", "def": { "trigger": "enter", "target": "children", "from": { "opacity": 0, "y": 40 }, "steps": [{ "to": { "opacity": 1, "y": 0 }, "duration": 800, "ease": "power3.out" }], "stagger": 100 } },
    "cascade-pop": { "label": "Pop in turn", "group": "stagger", "def": { "trigger": "enter", "target": "children", "from": { "opacity": 0, "scale": 0.8 }, "steps": [{ "to": { "opacity": 1, "scale": 1 }, "duration": 650, "ease": "back.out" }], "stagger": 80 } },
    "cascade-center": { "label": "From the center", "group": "stagger", "def": { "trigger": "enter", "target": "children", "from": { "opacity": 0, "y": 30, "scale": 0.95 }, "steps": [{ "to": { "opacity": 1, "y": 0, "scale": 1 }, "duration": 800, "ease": "power3.out" }], "stagger": 90, "order": "center" } },
    "cascade-flip": { "label": "Cards flip", "group": "stagger", "def": { "trigger": "enter", "target": "children", "from": { "opacity": 0, "rotateY": -60 }, "steps": [{ "to": { "opacity": 1, "rotateY": 0 }, "duration": 900, "ease": "power3.out" }], "stagger": 110 } },
    "cascade-random": { "label": "Random fade", "group": "stagger", "def": { "trigger": "enter", "target": "children", "from": { "opacity": 0, "scale": 0.9 }, "steps": [{ "to": { "opacity": 1, "scale": 1 }, "duration": 700, "ease": "power2.out" }], "stagger": 70, "order": "random" } },

    "parallax": { "label": "Parallax", "group": "scroll", "def": { "trigger": "scroll", "from": { "y": 120 }, "steps": [{ "to": { "y": -120 }, "duration": 1000, "ease": "none" }], "start": 0, "end": 100, "smooth": 0.5 } },
    "scroll-grow": { "label": "Fade & grow in", "group": "scroll", "def": { "trigger": "scroll", "from": { "opacity": 0, "scale": 0.85 }, "steps": [{ "to": { "opacity": 1, "scale": 1 }, "duration": 1000, "ease": "power2.out" }], "start": 0, "end": 45 } },
    "scroll-wipe": { "label": "Wipe reveal", "group": "scroll", "def": { "trigger": "scroll", "from": { "clip": "wipe-up" }, "steps": [{ "to": { "clip": "none" }, "duration": 1000, "ease": "power2.out" }], "start": 5, "end": 50 } },
    "scroll-zoom": { "label": "Zoom through", "group": "scroll", "def": { "trigger": "scroll", "from": { "scale": 0.7 }, "steps": [{ "to": { "scale": 1.15 }, "duration": 1000, "ease": "none" }], "start": 0, "end": 100, "smooth": 0.4 } },
    "scroll-rotate": { "label": "Rotate", "group": "scroll", "def": { "trigger": "scroll", "from": { "rotate": -45 }, "steps": [{ "to": { "rotate": 45 }, "duration": 1000, "ease": "none" }], "start": 0, "end": 100, "smooth": 0.5 } },
    "scroll-slide": { "label": "Slide across", "group": "scroll", "def": { "trigger": "scroll", "from": { "x": "-25%" }, "steps": [{ "to": { "x": "25%" }, "duration": 1000, "ease": "none" }], "start": 0, "end": 100, "smooth": 0.5 } },
    "scroll-focus": { "label": "Focus in & out", "group": "scroll", "def": { "trigger": "scroll", "from": { "opacity": 0.3, "blur": 12 }, "steps": [{ "to": { "opacity": 1, "blur": 0 }, "duration": 500, "ease": "power2.out" }, { "to": { "opacity": 0.3, "blur": 12 }, "duration": 500, "delay": 300, "ease": "power2.in" }], "start": 0, "end": 100 } },
    "scroll-letters": { "label": "Letters on scroll", "group": "scroll", "def": { "trigger": "scroll", "target": "chars", "from": { "opacity": 0.15 }, "steps": [{ "to": { "opacity": 1 }, "duration": 300, "ease": "none" }], "stagger": 40, "start": 10, "end": 60 } },

    "hover-lift": { "label": "Lift", "group": "interaction", "def": { "trigger": "hover", "steps": [{ "to": { "y": -8, "scale": 1.02 }, "duration": 350, "ease": "power3.out" }] } },
    "hover-grow": { "label": "Grow", "group": "interaction", "def": { "trigger": "hover", "steps": [{ "to": { "scale": 1.06 }, "duration": 350, "ease": "power2.out" }] } },
    "hover-tilt": { "label": "Tilt", "group": "interaction", "def": { "trigger": "hover", "steps": [{ "to": { "rotate": -3, "scale": 1.03 }, "duration": 450, "ease": "back.out" }] } },
    "hover-spin": { "label": "Spin", "group": "interaction", "def": { "trigger": "hover", "steps": [{ "to": { "rotate": 360 }, "duration": 800, "ease": "power3.inOut" }] } },
    "hover-wave": { "label": "Letters wave", "group": "interaction", "def": { "trigger": "hover", "target": "chars", "steps": [{ "to": { "y": -6 }, "duration": 250, "ease": "power2.out" }], "stagger": 20 } },
    "hover-jelly": { "label": "Jelly", "group": "interaction", "def": { "trigger": "hover", "steps": [{ "to": { "scaleX": 1.15, "scaleY": 0.85 }, "duration": 150, "ease": "power1.out" }, { "to": { "scaleX": 0.9, "scaleY": 1.1 }, "duration": 150, "ease": "power1.inOut" }, { "to": { "scaleX": 1.05, "scaleY": 0.95 }, "duration": 150, "ease": "power1.inOut" }, { "to": { "scaleX": 1, "scaleY": 1 }, "duration": 250, "ease": "power2.out" }] } },
    "click-press": { "label": "Press bounce", "group": "interaction", "def": { "trigger": "click", "steps": [{ "to": { "scale": 0.9 }, "duration": 100, "ease": "power2.out" }, { "to": { "scale": 1 }, "duration": 700, "ease": "elastic.out" }] } },

    "float": { "label": "Float", "group": "loop", "def": { "trigger": "loop", "steps": [{ "to": { "y": -14 }, "duration": 1600, "ease": "sine.inOut" }], "yoyo": true } },
    "pulse": { "label": "Pulse", "group": "loop", "def": { "trigger": "loop", "steps": [{ "to": { "scale": 1.07 }, "duration": 900, "ease": "sine.inOut" }], "yoyo": true } },
    "sway": { "label": "Sway", "group": "loop", "def": { "trigger": "loop", "from": { "rotate": -4 }, "steps": [{ "to": { "rotate": 4 }, "duration": 2000, "ease": "sine.inOut" }], "yoyo": true } },
    "spin": { "label": "Spin", "group": "loop", "def": { "trigger": "loop", "steps": [{ "to": { "rotate": 360 }, "duration": 8000, "ease": "none" }] } },
    "wiggle": { "label": "Wiggle", "group": "loop", "def": { "trigger": "loop", "steps": [{ "to": { "rotate": -8 }, "duration": 100, "ease": "sine.inOut" }, { "to": { "rotate": 8 }, "duration": 100, "ease": "sine.inOut" }, { "to": { "rotate": -6 }, "duration": 100, "ease": "sine.inOut" }, { "to": { "rotate": 6 }, "duration": 100, "ease": "sine.inOut" }, { "to": { "rotate": 0 }, "duration": 100, "ease": "sine.inOut" }, { "to": {}, "duration": 0, "delay": 1800 }] } },
    "heartbeat": { "label": "Heartbeat", "group": "loop", "def": { "trigger": "loop", "steps": [{ "to": { "scale": 1.15 }, "duration": 150, "ease": "power2.out" }, { "to": { "scale": 1 }, "duration": 150, "ease": "power2.in" }, { "to": { "scale": 1.12 }, "duration": 150, "ease": "power2.out" }, { "to": { "scale": 1 }, "duration": 300, "ease": "power2.in" }, { "to": {}, "duration": 0, "delay": 900 }] } }
  }
}

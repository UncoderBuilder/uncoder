{
	"id": "content-gallery-grid",
	"title": "Content: photo gallery grid",
	"category": "content",
	"description": "Split header (eyebrow and h2 on the left, a short line and an outline button on the right) above an Image Gallery widget: six square rounded photos in a 3-column grid that open in a lightbox — three columns on tablets, two on phones. Use it to show your space, products, food, projects or events; replace every placeholder with a real photo and alt text, and add or remove photos in the gallery’s Images setting.",
	"keywords": [
		"gallery",
		"photos",
		"images",
		"grid",
		"portfolio",
		"showcase",
		"instagram"
	],
	"elements": [
		{
			"type": "container",
			"label": "Gallery",
			"settings": {
				"gap": {
					"size": 48,
					"unit": "px"
				},
				"gap_mobile": {
					"size": 32,
					"unit": "px"
				}
			},
			"children": [
				{
					"type": "container",
					"settings": {
						"direction": "row",
						"direction_mobile": "column",
						"justify": "space-between",
						"align": "flex-end",
						"align_mobile": "flex-start",
						"gap": {
							"size": 48,
							"unit": "px"
						},
						"gap_mobile": {
							"size": 16,
							"unit": "px"
						}
					},
					"children": [
						{
							"type": "container",
							"settings": {
								"width": {
									"size": 56,
									"unit": "%"
								},
								"width_mobile": {
									"size": 100,
									"unit": "%"
								},
								"gap": {
									"size": 16,
									"unit": "px"
								}
							},
							"children": [
								{
									"type": "heading",
									"settings": {
										"title": "Gallery",
										"tag": "p",
										"typography": {
											"preset": "eyebrow"
										},
										"color": "var(--uncoder-c-primary)"
									}
								},
								{
									"type": "heading",
									"settings": {
										"title": "A look inside",
										"tag": "h2",
										"typography": {
											"preset": "h2"
										},
										"text_wrap": "balance"
									}
								}
							]
						},
						{
							"type": "container",
							"settings": {
								"width": {
									"size": 38,
									"unit": "%"

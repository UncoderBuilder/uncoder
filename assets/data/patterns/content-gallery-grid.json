								"align": "flex-start"
							},
							"children": [
								{
									"type": "text-editor",
									"settings": {
										"content": "<p>[One line about what these photos show — your space, your work, your team or your food.]</p>"
									}
								},
								{
									"type": "button",
									"settings": {
										"text": "See more photos",
										"link": {
											"url": "/gallery"
										},
										"variant": "outline"
									}
								}
							]
						}
					]
				},
				{
					"type": "image-gallery",
					"settings": {
						"gallery": [
							{
								"id": 0,
								"url": "{{placeholder_image}}",
								"alt": "[Describe photo 1]"
							},
							{
								"id": 0,
								"url": "{{placeholder_image}}",
								"alt": "[Describe photo 2]"
							},
							{
								"id": 0,

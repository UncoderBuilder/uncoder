								"alt": "[Describe photo 4]"
							},
							{
								"id": 0,
								"url": "{{placeholder_image}}",
								"alt": "[Describe photo 5]"
							},
							{
								"id": 0,
								"url": "{{placeholder_image}}",
								"alt": "[Describe photo 6]"
							}
						],
						"layout": "grid",
						"columns": 3,
						"columns_tablet": 3,
						"columns_mobile": 2,
						"ratio": "1/1",
						"gap": {
							"size": 16,
							"unit": "px"
						},
						"gap_mobile": {
							"size": 10,
							"unit": "px"
						},
						"link_to": "lightbox",
						"radius": {
							"top": 16,
							"right": 16,
							"bottom": 16,
							"left": 16,
							"unit": "px",
							"linked": true
						},
						"radius_mobile": {
							"top": 12,
							"right": 12,
							"bottom": 12,
							"left": 12,
							"unit": "px",
							"linked": true
						}
					}
				}
			]
		}
	]

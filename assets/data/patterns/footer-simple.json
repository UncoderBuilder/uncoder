{
	"id": "footer-simple",
	"title": "Footer: simple, light",
	"category": "footer",
	"description": "Compact light footer: logo, a single row of links and social icons, then copyright and legal links. Centered on phones. Use it in a footer template.",
	"keywords": [
		"footer",
		"simple",
		"light",
		"minimal",
		"links",
		"copyright"
	],
	"elements": [
		{
			"type": "container",
			"label": "Footer",
			"settings": {
				"tag": "footer",
				"gap": {
					"size": 32,
					"unit": "px"
				},
				"gap_mobile": {
					"size": 24,
					"unit": "px"
				},
				"background": {
					"type": "classic",
					"color": "var(--uncoder-c-white)"
				},
				"border": {
					"style": "solid",
					"width": {
						"top": 1,
						"right": 0,
						"bottom": 0,
						"left": 0,
						"unit": "px",
						"linked": false
					},
					"color": "var(--uncoder-c-border)"
				},
				"_padding": {
					"top": 48,
					"right": "",
					"bottom": 32,
					"left": "",
					"unit": "px",
					"linked": false
				},

									{
										"text": "About",
										"icon": {
											"library": "none",
											"value": ""
										},
										"link": {
											"url": "/about"
										}
									},
									{
										"text": "Blog",
										"icon": {
											"library": "none",
											"value": ""
										},
										"link": {
											"url": "/blog"
										}
									},
									{
										"text": "Contact",

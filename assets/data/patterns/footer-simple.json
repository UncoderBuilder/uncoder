						"direction": "row",
						"direction_mobile": "column",
						"justify": "space-between",
						"align": "center",
						"gap": {
							"size": 12,
							"unit": "px"
						},
						"border": {
							"style": "solid",
							"width": {
								"top": 1,
								"right": 0,
								"bottom": 0,
								"left": 0,
								"unit": "px",

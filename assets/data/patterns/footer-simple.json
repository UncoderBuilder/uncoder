									},
									{
										"network": "instagram",
										"link": {
											"url": "https://www.instagram.com/"
										}
									},
									{
										"network": "x",
										"link": {
											"url": "https://x.com/"
										}
									}
								],
								"view": "minimal",
								"color_mode": "custom",
								"primary_color": "var(--uncoder-c-muted)",

{
	"id": "hero-background-image",
	"title": "Hero: full-width background image with overlay",
	"category": "hero",
	"description": "Tall hero with a full-bleed background image, a dark overlay for contrast and white text: eyebrow, h1, lead paragraph and two buttons. Replace the placeholder image with a real photo.",
	"keywords": [
		"hero",
		"background",
		"image",
		"overlay",
		"photo",
		"full width",
		"banner"
	],
	"elements": [
		{
			"type": "container",
			"label": "Hero",
			"settings": {
				"min_height": {
					"size": 82,
					"unit": "vh"
				},
				"min_height_mobile": {
					"size": 560,
					"unit": "px"
				},
				"justify": "center",
				"background": {
					"type": "classic",
					"color": "var(--uncoder-c-black)",
					"image": {
						"id": 0,
						"url": "{{placeholder_image}}"
					},
					"size": "cover",
					"position": "center center"
				},
				"overlay": {
					"type": "classic",
					"color": "var(--uncoder-c-black)"
				},
				"overlay_opacity": 0.62,
				"text_color": "var(--uncoder-c-white)",
				"_padding": {
					"top": 128,
					"right": "",
					"bottom": 128,
					"left": "",
					"unit": "px",
					"linked": false
				},
				"_padding_tablet": {
					"top": 104,
					"right": "",
					"bottom": 104,
					"left": "",
					"unit": "px",
					"linked": false
				},
				"_padding_mobile": {
					"top": 80,
					"right": "",
					"bottom": 80,
					"left": "",
					"unit": "px",
					"linked": false
				}
			},
			"children": [
				{
					"type": "container",
					"settings": {
						"width": {
							"size": 62,
							"unit": "%"
						},
						"width_tablet": {
							"size": 80,
							"unit": "%"
						},
						"width_mobile": {
							"size": 100,
							"unit": "%"
						},
						"gap": {
							"size": 24,
							"unit": "px"
						}
					},
					"children": [
						{
							"type": "heading",
							"settings": {
								"title": "[Your location or specialty]",
								"tag": "p",
								"typography": {
									"preset": "eyebrow"
								},
								"color": "color-mix(in srgb, var(--uncoder-c-white) 80%, transparent)"
							}
						},
						{
							"type": "heading",
							"settings": {
								"title": "Spaces designed around the way you live",
								"tag": "h1",
								"typography": {
									"preset": "display"
								},
								"text_wrap": "balance"
							}
						},
						{
							"type": "text-editor",
							"settings": {
								"content": "<p>We plan, design and build calm, practical homes and workplaces — with one team from the first sketch to the final handover.</p>",
								"typography": {
									"preset": "lead"
								},
								"max_width": {
									"size": 52,
									"unit": "ch"
								},
								"color": "color-mix(in srgb, var(--uncoder-c-white) 86%, transparent)"
							}
						},
						{
							"type": "container",
							"settings": {
								"direction": "row",
								"direction_mobile": "column",
								"gap": {
									"size": 12,
									"unit": "px"
								},
								"wrap": "wrap",
								"_margin": {
									"top": 8,
									"right": "",
									"bottom": "",
									"left": "",
									"unit": "px",
									"linked": false
								}
							},
							"children": [
								{
									"type": "button",
									"settings": {
										"text": "Start your project",
										"link": {
											"url": "/contact"
										},
										"size": "lg",
										"background": {
											"type": "classic",
											"color": "var(--uncoder-c-white)"
										},
										"text_color": "var(--uncoder-c-heading)",
										"hover_background": {
											"type": "classic",
											"color": "var(--uncoder-c-surface)"
										},
										"hover_text_color": "var(--uncoder-c-heading)",
										"align_mobile": "stretch"
									}
								},
								{
									"type": "button",
									"settings": {
										"text": "View our work",
										"link": {
											"url": "/projects"
										},
										"size": "lg",
										"variant": "outline",
										"text_color": "var(--uncoder-c-white)",
										"hover_text_color": "var(--uncoder-c-white)",
										"hover_background": {
											"type": "classic",
											"color": "color-mix(in srgb, var(--uncoder-c-white) 12%, transparent)"
										},
										"align_mobile": "stretch"
									}
								}
							]
						}
					]
				}
			]
		}
	]
}

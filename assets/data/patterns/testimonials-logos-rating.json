									"preset": "eyebrow"
								},
								"color": "var(--uncoder-c-primary)"
							}
						},
						{
							"type": "heading",
							"settings": {
								"title": "Rated [4.9] out of 5 by our customers",
								"tag": "h2",
								"typography": {
									"preset": "h2"
								},
								"text_wrap": "balance"
							}
						},
						{
							"type": "star-rating",
							"settings": {
								"rating": 4.9,
								"marked_color": "var(--uncoder-c-accent)",

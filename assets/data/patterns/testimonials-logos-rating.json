		{
			"type": "container",
			"label": "Testimonials",
			"settings": {
				"direction": "row",
				"direction_tablet": "column",
				"direction_mobile": "column",
				"align": "center",
				"gap": {
					"size": 64,
					"unit": "px"
				},
				"gap_tablet": {
					"size": 40,
					"unit": "px"
				},
				"gap_mobile": {
					"size": 32,
					"unit": "px"
				},
				"background": {
					"type": "classic",
					"color": "var(--uncoder-c-surface)"
				}
			},
			"children": [
				{
					"type": "container",
					"settings": {
						"width": {
							"size": 38,
							"unit": "%"

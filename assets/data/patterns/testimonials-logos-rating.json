{
	"id": "testimonials-logos-rating",
	"title": "Testimonials: rating summary with logos",
	"category": "social-proof",
	"description": "Surface band with a rating summary on the left (h2 with your average score, a Star Rating widget, the number of reviews and three review-site or press logos) and two testimonial cards with photos on the right. Stacks on tablets and phones. Use it when you have public ratings to point to; keep the score in the heading, the stars and the review count accurate.",
	"keywords": [
		"testimonials",
		"rating",
		"reviews",
		"stars",
		"logos",
		"social proof",
		"trust"
	],
